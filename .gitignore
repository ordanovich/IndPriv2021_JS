# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ── Build output (390 MB compiled bundle — regenerate with: npm run build) ──
terria_frontend/wwwroot/build/

# ── Large binary / geodata files (too large for GitHub without LFS) ─────────
terria_frontend/wwwroot/data/*.geojson
!terria_frontend/wwwroot/data/secciones_demo.geojson
data_pipeline/data/

# ── Demo gh-pages dist (built locally; not tracked) ─────────────────────────
dist/

# ── R artifacts ─────────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/

# ── OS / editor noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.log
.vscode/
.idea/

# Local tool settings are in .git/info/exclude (never committed)


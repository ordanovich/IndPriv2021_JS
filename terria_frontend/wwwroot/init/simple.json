            { "value": "1. Inferior [-2,82/-0,82]",        "color": "#1a9850" },
            { "value": "2. Intermedio bajo [-0,82/-0,26]", "color": "#91cf60" },
            { "value": "3. Intermedio [-0,26/0,20]",       "color": "#ffffbf" },
            { "value": "4. Intermedio alto [0,20/0,76]",   "color": "#fc8d59" },
            { "value": "5. Superior [0,76/7,29]",          "color": "#d73027" }
          ]
        }
      }

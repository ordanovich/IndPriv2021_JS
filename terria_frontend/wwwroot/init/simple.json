        { "name": "CUSEC",     "type": "hidden" },
        { "name": "NMUN",      "type": "hidden" },
        { "name": "NPRO",      "type": "hidden" }
      ],
      "featureInfoTemplate": {
        "name": "{{NMUN}} — {{CUSEC}}",
        "template": "<div style='font-family:-apple-system,BlinkMacSystemFont,sans-serif;max-width:300px;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.15)'><div style='background:#f3f4f6;color:#111827;padding:10px 14px;border-bottom:1px solid #e5e7eb'><div style='font-size:11px;color:#6b7280;text-transform:uppercase;letter-spacing:0.5px'>{{NPRO}}</div><div style='font-size:16px;font-weight:700;margin:2px 0;color:#111827'>{{NMUN}}</div><div style='font-size:11px;color:#9ca3af'>Sección: {{CUSEC}}</div></div><div style='padding:12px 14px;background:white'><table style='width:100%;border-collapse:collapse;font-size:13px'><tr><td style='padding:8px 0 4px;color:#555;font-size:12px'>Índice bruto (2011)</td><td style='text-align:right;padding:8px 0 4px;font-weight:700;font-size:15px;color:#222'>{{IP2011}}</td></tr><tr><td style='padding:2px 0 10px;color:#777;font-size:11px'>Quintil</td><td style='text-align:right;padding:2px 0 10px;font-size:11px;color:#555'>{{Q11_Label}}</td></tr></table><div style='border-top:1px solid #eee;padding-top:8px'><div style='font-size:10px;color:#bbb;margin-bottom:4px;text-transform:uppercase;letter-spacing:0.5px'>Escala de privación</div><div style='height:8px;border-radius:4px;background:linear-gradient(to right,#1a9850 0%,#91cf60 25%,#ffffbf 50%,#fc8d59 75%,#d73027 100%)'></div><div style='font-size:10px;color:#bbb;margin-top:3px'><span style='float:left'>Inferior</span><span style='float:right'>Superior</span></div></div></div></div>"
      },

    */
    "brandBarElements": [
      "<div style='display:flex;flex-direction:column;align-items:center;justify-content:center;padding:2px 16px;gap:3px;background:#ffffff'><span style='color:#111827;font-size:12px;font-weight:700;letter-spacing:0.3px;white-space:nowrap;line-height:1.2'>Atlas de Privación de España</span><img src='images/logo.jpg' style='height:28px;width:auto;object-fit:contain;display:block;max-width:180px' alt='Logo institucional' onerror=\"this.style.display='none'\"/></div>",
      "",
      ""
